# Copy to .env (and .env.local for Next.js). Never commit real values.

# ---- Modes ----
REALTIME_MODE=nexconn          # nexconn | mock   (mock is for tests/local only)
LLM_MODE=live                  # live | mock
INGEST_MODE=dual               # dual | webhook | post
ALLOW_MOCK_IN_PROD=0

# ---- Nexconn (console.nexconn.ai) ----
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_PRIMARY_API_DOMAIN=    # from console, e.g. https://api.<region>...
NEXCONN_SECONDARY_API_DOMAIN=
NEXT_PUBLIC_NEXCONN_APP_KEY=   # same as NEXCONN_APP_KEY (public)
NEXT_PUBLIC_NEXCONN_AREA=      # SDK area / data-center code from console
NEXCONN_WEBHOOK_SECRET=        # if the console provides a separate one; else leave empty
NEXCONN_TEXT_ENVELOPE=0        # 1 = send RC:TxtMsg envelopes if CP:* custom types do not reach Web clients (U4 fallback)

# ---- AI ----
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
ANTHROPIC_SMART_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_FAST_MODEL=             # fallback LLM; set a current fast model id
OPENAI_TTS_MODEL=              # optional; set a current TTS model id
OPENAI_TTS_VOICE=

# ---- App ----
APP_URL=http://localhost:3000
SESSION_SECRET=                # 32+ random chars
ADMIN_TOKEN=                   # protects /admin and export
DATABASE_URL=                  # empty = embedded PGlite at ./.data/pglite
PGLITE_DIR=./.data/pglite      # embedded DB location when DATABASE_URL is empty (single instance only)
LOG_LEVEL=info                 # pino level: debug | info | warn | error | silent
NEXT_PUBLIC_REPO_URL=          # public GitHub URL; the footer shows a GitHub link only when set

# ---- Feature flags ----
FEATURE_TTS=0
FEATURE_MULTILINGUAL=0
FEATURE_CHEERS=1

# ---- Tunables (ms) ----
PROMPT_MS=6000
STORM_MS=30000
VOTE_MS=12000
REVEAL_MS=12000
DISTILL_BUDGET_MS=8000         # total AI budget before heuristic options
DISTILL_HARD_CAP_MS=10000
ROOM_PLAYER_CAP=450            # keep below the 500 concurrent-connection plan limit
TIMING_SCALE=1                 # tests/demos only: multiplies every phase duration (e2e uses <1). Keep 1 in production.
